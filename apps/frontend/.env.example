# ==============================
# Backend API
# ==============================
# URL API backend NestJS lokal.
# Sesuaikan port dengan port backend yang sedang dijalankan.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ==============================
# Pencarian lokasi peta (Geoapify)
# ==============================
# Ganti placeholder dengan API key Geoapify milik deployment Anda.
# Di Vercel, tambahkan variable yang sama pada Project Settings > Environment Variables.
# NEXT_PUBLIC_* akan dikirim ke browser; key ini bukan secret. Batasi domain,
# kuota, dan API yang diizinkan melalui dashboard Geoapify.
NEXT_PUBLIC_GEOAPIFY_API_KEY=isi-api-key-geoapify-di-sini
