# ==============================
# Runtime aplikasi NestJS
# ==============================
NODE_ENV=development
PORT=4000

# ==============================
# Database PostgreSQL / Neon
# ==============================
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ==============================
# Session dan keamanan aplikasi
# ==============================
SESSION_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-cron-secret

# ==============================
# Integrasi Telegram
# ==============================
TELEGRAM_TOKEN=replace-with-telegram-bot-token
ADMIN_ID=replace-with-telegram-admin-id

# ==============================
# URL dan CORS
# ==============================
BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ==============================
# Akun untuk integration test
# ==============================
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=replace-with-test-password
