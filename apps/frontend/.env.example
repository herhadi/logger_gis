# ==============================
# Backend API
# ==============================
# URL API backend NestJS lokal.
# Sesuaikan port dengan port backend yang sedang dijalankan.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ==============================
# Pencarian lokasi peta (Geoapify)
# ==============================
# Isi dengan API key Geoapify untuk mengaktifkan pencarian lokasi.
# Variabel NEXT_PUBLIC_* dikirim ke browser; perlakukan key sebagai public
# dan batasi domain/penggunaannya melalui dashboard Geoapify.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
