# Template environment backend legacy/root.
# Frontend Next.js memiliki template sendiri di apps/frontend/.env.example.

# ==============================
# Runtime aplikasi
# ==============================
NODE_ENV=development
PORT=4000

# ==============================
# Database PostgreSQL / PostGIS
# ==============================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# ==============================
# Session dan keamanan
# ==============================
SESSION_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-cron-secret

# ==============================
# Integrasi Telegram
# ==============================
TELEGRAM_TOKEN=replace-with-telegram-bot-token
ADMIN_ID=replace-with-telegram-admin-id

# ==============================
# URL service dan kebijakan CORS
# ==============================
BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ==============================
# Akun khusus integration test (bukan akun production)
# ==============================
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=replace-with-test-password
