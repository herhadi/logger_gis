# Environment khusus test lokal/staging. Jangan gunakan database production.

# ==============================
# Runtime dan kontrol test
# ==============================
NODE_ENV=development
RUN_INTEGRATION_TESTS=1

# ==============================
# Database khusus test
# ==============================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gis_watermeter_test

# ==============================
# Session dan secret test
# ==============================
SESSION_SECRET=replace-with-test-secret
CRON_SECRET=replace-with-test-cron-secret

# ==============================
# Dummy integrasi Telegram (tidak mengirim pesan live)
# ==============================
TELEGRAM_TOKEN=dummy-token
ADMIN_ID=dummy-admin
